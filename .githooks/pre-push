#!/bin/sh
# Pre-push secret scan. This repo is PUBLIC on GitHub: anything pushed is world readable.
# Enable once per clone: git config core.hooksPath .githooks
# Scans added lines in the outgoing diff for credential patterns and blocks the push.
# Patterns use [b]racket tricks so this file never matches itself.
# 2026-07-06: also runs the shared CLAUDE.md guardrails (canonical checker lives
# in the iris-automation repo) when the push touches CLAUDE.md.

EMPTY_TREE=4b825dc642cb6eb9a060e54bf8d69288fbee4904
Z40=0000000000000000000000000000000000000000
status=0
CLAUDE_MD_TOUCHED=0

while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$Z40" ] && continue
  # New branch: diff against origin/main (what is actually NEW to the public
  # repo) instead of the empty tree. The empty-tree base rescanned the whole
  # repo on every new-branch push and re-flagged long-committed non-secret
  # identifiers (e.g. wrangler.toml KV namespace ids). Fixed 2026-07-03.
  if [ "$remote_sha" = "$Z40" ]; then
    base=$(git rev-parse --verify -q origin/main) || base="$EMPTY_TREE"
  else
    base="$remote_sha"
  fi
  # Neutralize the public R2 CDN subdomain (pub-<32hex>.r2.dev) before scanning:
  # it is a documented PUBLIC bucket URL served to every site visitor and already
  # appears across this repo (index.html, yours.html, etc.), so it is not a leak.
  # The substitution only removes that token, so a real secret elsewhere on the
  # same line is still caught by the patterns below.
  hits=$(git diff "$base" "$local_sha" 2>/dev/null | grep -E '^\+' | sed -E 's/pub-[0-9a-f]{32}\.r2\.dev/pub-PUBLIC.r2.dev/g' | grep -E \
    -e '[p]it-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' \
    -e '[E]AA[A-Za-z0-9]{30,}' \
    -e '[s]k_live_[A-Za-z0-9]{10,}' \
    -e '[r]k_live_[A-Za-z0-9]{10,}' \
    -e '[w]hsec_[A-Za-z0-9]{10,}' \
    -e '[Bb]earer [0-9a-fA-F]{24,}' \
    -e '\b[0-9a-f]{32}\b' \
    -e 'BEGIN [A-Z ]*PRIVATE KEY')
  if [ -n "$hits" ]; then
    echo "PUSH BLOCKED: possible secret in outgoing diff for $local_ref" >&2
    echo "$hits" | head -10 >&2
    echo "This repo is public. Replace the value with a redacted fingerprint or move it to the private repo, then push again." >&2
    status=1
  fi

  touched=$(git diff --name-only "$base" "$local_sha" 2>/dev/null | grep -E '(^|/)CLAUDE\.md$')
  [ -n "$touched" ] && CLAUDE_MD_TOUCHED=1
done

# 2026-07-08 tracking invariant (incident: CSP analytics blackout 7/03-7/08).
# Analytics silently dying in a routine ship is not acceptable; this check
# verifies the outgoing tree on EVERY push, regardless of what the push
# touches. If a page legitimately drops a tag or the manifest changes, edit
# the manifest here in the same commit and say so in the commit body.
TIP=$(git rev-parse -q --verify HEAD)
check_contains() { # file, needle, label
  if ! git show "$TIP:$1" 2>/dev/null | grep -q "$2"; then
    echo "PUSH BLOCKED: tracking invariant failed: $1 is missing $3" >&2
    status=1
  fi
}
# CSP must allow the analytics endpoints (bare apex, not just the wildcard)
check_contains "_headers" " analytics.google.com "               "bare analytics.google.com in CSP"
check_contains "_headers" "static.cloudflareinsights.com"        "Cloudflare beacon origin in CSP"
check_contains "_headers" "www.googletagmanager.com"             "googletagmanager origin in CSP"
check_contains "_headers" "connect.facebook.net"                 "Meta pixel origin in CSP"
# Tag manifest: which measurement each public page must carry
check_contains "index.html"            "GTM-M74R95NX"  "GTM container"
check_contains "venues/index.html"     "GTM-M74R95NX"  "GTM container"
check_contains "thanks.html"           "G-XGSWD6JW3E"  "GA4 tag"
check_contains "films.html"            "G-XGSWD6JW3E"  "GA4 tag"
check_contains "calculator/index.html" "G-XGSWD6JW3E"  "GA4 tag"
check_contains "quiz/index.html"       "G-XGSWD6JW3E"  "GA4 tag"
check_contains "start.html"            "G-XGSWD6JW3E"  "GA4 tag"
check_contains "404.html"              "G-XGSWD6JW3E"  "GA4 tag"
for pg in index.html thanks.html films.html experience.html saved.html venues/index.html start.html 404.html; do
  check_contains "$pg" "fbq(" "Meta pixel"
done
# Microsoft Clarity (2026-07-08): CSP in both directives + snippet on both
# pages. The official snippet concatenates the tag URL, so the pages are
# checked for the URL prefix and the project id as two separate needles.
check_contains "_headers" "script-src[^;]*clarity\.ms"  "clarity.ms in script-src"
check_contains "_headers" "connect-src[^;]*clarity\.ms" "clarity.ms in connect-src"
check_contains "_headers" "connect-src[^;]*c\.bing\.com" "c.bing.com in connect-src"
for pg in index.html thanks.html start.html 404.html; do
  check_contains "$pg" "clarity\.ms/tag/" "Clarity tag loader"
  check_contains "$pg" "xj2t05exbz"       "Clarity project id"
done

if [ "$CLAUDE_MD_TOUCHED" = "1" ]; then
  CHECKER="C:/Users/flyin/Claude Projects/iris-automation/scripts/hooks/claude-md-checks.sh"
  if [ -f "$CHECKER" ]; then
    sh "$CHECKER" || status=1
  else
    echo "###########################################################################" >&2
    echo "# WARNING: CLAUDE.md guardrail checker NOT FOUND. Push allowed anyway,   #" >&2
    echo "# but the dash / precedence / token-budget / locked-list checks DID NOT  #" >&2
    echo "# RUN. The drift-checker is itself missing; fix this NOW, not later.     #" >&2
    echo "# Expected path:                                                          #" >&2
    echo "#   C:/Users/flyin/Claude Projects/iris-automation/scripts/hooks/claude-md-checks.sh" >&2
    echo "# Fix: restore it from git:                                               #" >&2
    echo '#   git -C "C:/Users/flyin/Claude Projects/iris-automation" checkout -- scripts/hooks/claude-md-checks.sh' >&2
    echo "###########################################################################" >&2
  fi
fi

exit $status
